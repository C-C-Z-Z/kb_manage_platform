# ===== 应用服务 =====
APP_NAME=kb-manage-platform
APP_ENV=local
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO
APP_WORKERS=1
APP_API_PREFIX=/api/v1
APP_SSE_HEARTBEAT_SECONDS=15
APP_SSE_TIMEOUT_SECONDS=300
CORS_ORIGINS=http://localhost:5173

# ===== MySQL =====
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=kb_manage
MYSQL_USER=kb_app
MYSQL_PASSWORD=CHANGE_ME
MYSQL_ROOT_PASSWORD=CHANGE_ME
MYSQL_CHARSET=utf8mb4
MYSQL_POOL_SIZE=10
MYSQL_JOB_POLL_INTERVAL_SECONDS=2
MYSQL_JOB_BATCH_SIZE=10
MYSQL_JOB_LOCK_TIMEOUT_SECONDS=300
MYSQL_JOB_MAX_ATTEMPTS=3

# ===== 周期调度器 =====
SCHEDULER_ENABLED=true
SCHEDULER_POLL_INTERVAL_SECONDS=30
# 设置为 0 可单独关闭对应周期任务。
SCHEDULER_FAQ_MINING_INTERVAL_SECONDS=86400
SCHEDULER_FAQ_MINING_WINDOW_DAYS=30
SCHEDULER_GAP_DETECTION_INTERVAL_SECONDS=86400
SCHEDULER_GAP_DETECTION_WINDOW_DAYS=30
SCHEDULER_OPERATOR_ID=system-scheduler
MODEL_CONFIG_REFRESH_INTERVAL_SECONDS=10

# ===== Redis =====
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=CHANGE_ME
REDIS_CACHE_TTL_SECONDS=3600
REDIS_PERMISSION_TTL_SECONDS=300
REDIS_LOCK_TTL_SECONDS=60
REDIS_HYDE_CACHE_TTL_SECONDS=900

# ===== MinIO =====
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME
MINIO_SECURE=false
MINIO_RAW_BUCKET=kb-raw
MINIO_MARKDOWN_BUCKET=kb-markdown
MINIO_IMAGE_BUCKET=kb-images
# 兼容统一桶配置；留空时使用上面的业务桶。
MINIO_BUCKET_NAME=knowledge-base
MINIO_IMG_DIR=upload-images

# ===== Milvus =====
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_URL=http://127.0.0.1:19530
MILVUS_DATABASE=default
MILVUS_USER=CHANGE_ME
MILVUS_PASSWORD=CHANGE_ME
MILVUS_COLLECTION=kb_chunks
CHUNKS_COLLECTION=kb_chunks
MILVUS_VECTOR_DIM=1024
MILVUS_METRIC_TYPE=COSINE
MILVUS_INDEX_TYPE=HNSW
MILVUS_TOP_K=20

# ===== 线上 MinerU API =====
MINERU_API_TOKEN=CHANGE_ME
MINERU_BASE_URL=https://mineru.net/api/v4
MINERU_TIMEOUT_SECONDS=600
MINERU_POLL_INTERVAL_SECONDS=3
MINERU_MAX_FILE_MB=100
MINERU_CONCURRENCY=2

# ===== VLM 图片理解 =====
VLM_BASE_URL=http://127.0.0.1:9001/v1
VLM_API_KEY=CHANGE_ME
VLM_MODEL=CHANGE_ME
VLM_TIMEOUT_SECONDS=120
VLM_MAX_IMAGE_MB=20
VLM_CONFIDENCE_THRESHOLD=0.75
VLM_PROMPT_VERSION=v1
# 兼容旧配置，填写后优先于 VLM_MODEL。
VL_MODEL=

# ===== OpenAI 兼容 LLM =====
OPENAI_API_KEY=CHANGE_ME
OPENAI_BASE_URL=https://api.example.com/v1
LLM_DEFAULT_MODEL=qwen-flash
LLM_DEFAULT_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=120
LLM_MAX_TOKENS=2048
LLM_HYDE_COUNT=3
LLM_HYDE_MAX_TOKENS=512
LLM_HYDE_TEMPERATURE=0.1

# ===== Embedding =====
EMBEDDING_BASE_URL=https://api.example.com/v1
EMBEDDING_API_KEY=CHANGE_ME
EMBEDDING_MODEL=CHANGE_ME
EMBEDDING_BATCH_SIZE=32
EMBEDDING_DIMENSION=1024
EMBEDDING_TIMEOUT_SECONDS=60
BGE_M3=BAAI/bge-m3
BGE_M3_PATH=D:\models\bge-m3
BGE_DEVICE=cpu
BGE_FP16=false

# ===== Reranker =====
RERANKER_BASE_URL=http://127.0.0.1:9002/v1
RERANKER_API_KEY=CHANGE_ME
RERANKER_MODEL=CHANGE_ME
RERANKER_TOP_N=30
RERANKER_TOP_K=8
RERANKER_TIMEOUT_SECONDS=60
# 兼容旧配置；留空时回退到上面的 RERANKER_*。
TEXT_RERANK_BASE_URL=
TEXT_RERANK_API_KEY=
TEXT_RERANK_MODEL=
TEXT_RERANK_INSTRUCT=Given a query, retrieve relevant passages that answer the query.

# ===== 检索与 FAQ =====
HYBRID_TOP_K=20
HYDE_TOP_K=20
RRF_K=60
RETRIEVAL_DEFAULT_TOP_K=8
# 命中关键词的全局候选不会自动发布，需人工审核。
FAQ_SENSITIVE_KEYWORDS=secret,密码,薪酬

# ===== JWT 与账号安全 =====
JWT_SECRET_KEY=CHANGE_ME_JWT_SECRET
JWT_EXPIRES_SECONDS=28800
JWT_ISSUER=kb-manage-platform
PASSWORD_LOCK_THRESHOLD=5
PASSWORD_LOCK_SECONDS=900
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
SEED_DEMO_DATA=true